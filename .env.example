# watchdog-os 配置模板
# 用法：复制为 .env 后按需修改   （cp .env.example .env）
# 本文件不含任何真实密钥，可安全提交；.env 本身已在 .gitignore 中。
#
# ★ 配置的唯一来源是 .env。config.json 已不再被服务读取，
#   config.example.json 只是字段总览模板（同样不参与配置）。
# ★ 未设置与空串一律视为「未设置」并回退默认值。

# == 必配（缺失则服务拒绝启动）==
# 访问密码
PASSWORD=

# JWT 令牌签名密钥，至少 32 字节。生成并写入 .env：node scripts/rotate-jwt-secret.mjs
# （轮换后所有已签发的会话立即失效；等价命令：openssl rand -hex 32）
JWT_SECRET=

# == 服务 ==
# 监听端口 / 监听地址（0.0.0.0 表示所有网卡）
PORT=
HOST=
# 子路径前缀，如 /tkp/（无需尾斜杠）
BASE_PATH=/

# == 监控采样 ==
# 监控哪些磁盘挂载点。JSON 数组；留空时 Windows 取项目所在盘、Linux 取 /
# ⚠️ 与 FS_ROOTS 不是一回事：DISK_MOUNTS 是采样目标，FS_ROOTS 是文件管理器权限白名单
DISK_MOUNTS=[]
COLLECT_INTERVAL=2000      # CPU / 内存采样间隔（ms）
DOCKER_INTERVAL=5000       # docker stats 刷新间隔（ms）
PROCESS_INTERVAL=10000     # 进程列表刷新间隔（ms）
PROCESS_TOP_N=50           # 进程列表返回条数（按 CPU 排序）

# == 会话安全（可选，均有合理默认值）==
# 令牌有效期（秒），自动收敛到 300 ~ 2592000
JWT_EXPIRES_IN=86400
# Cookie 的 Secure 策略：auto（默认，仅 HTTPS 请求附加）/ always / never
COOKIE_SECURE=auto
# 终端 WebSocket 的 Origin 白名单，逗号分隔；留空表示仅同源
PUBLIC_ORIGIN=

# == 登录审计日志（可选，默认开启）==
# 记录登录成功/失败、登出、受保护接口 401 未授权访问，按本地日期分文件落盘 JSONL
# （~/.watchdog-os/login-log/YYYY-MM-DD.jsonl）。日志不含密码、Cookie、令牌等任何凭据。
LOGIN_LOG_ENABLED=true
# 日志目录，留空 = ~/.watchdog-os/login-log（支持 ~ 前缀与绝对路径）
LOGIN_LOG_DIR=
# 保留天数（自动清理更早的日文件），收敛到 1 ~ 3650
LOGIN_LOG_RETENTION_DAYS=30
# 单次读取解析条数上限（面板 / CSV 共用），收敛到 100 ~ 200000
LOGIN_LOG_MAX_ENTRIES=20000
# 疑似暴力破解判定：同一 IP 在窗口内登录失败达到该次数，收敛到 2 ~ 100
LOGIN_LOG_BRUTE_THRESHOLD=5
# 暴力破解判定窗口（分钟），收敛到 1 ~ 1440
LOGIN_LOG_BRUTE_WINDOW_MIN=10
# 同 IP + 同路径的 401 合并窗口（秒）：防前端轮询在会话失效后刷爆日志，0 = 关闭去重
LOGIN_LOG_401_DEDUPE_SEC=60

# == 编辑器自动草稿（可选）==
# 编辑中的未保存内容自动缓存，落盘独立目录（不写 data.json：单份正文最大 2MB）
# 草稿目录，留空 = ~/.watchdog-os/drafts（支持 ~ 前缀与绝对路径）
DRAFT_DIR=
# 草稿条数上限（超出按最近修改淘汰），收敛到 1 ~ 500
DRAFT_MAX_ENTRIES=50
# 保留天数（启动时 + 写后节流清理），收敛到 1 ~ 3650
DRAFT_RETENTION_DAYS=30

# == 文件管理器（可选）==
# 允许浏览的根目录，按系统分隔符（Windows 用 ;，Linux 用 :）
# 留空时：Windows = 项目所在盘 + C 盘根，Linux = /
# 例：FS_ROOTS=/data:/home
FS_ROOTS=

# == 网络挂载 SMB / WebDAV（可选，仅 Linux）==
# Files 侧栏的 Network 分区把远程共享挂到本机后即可像本地目录一样浏览。
# 挂载需 root：先 apt install cifs-utils davfs2，并配置 scripts/mount-helper.sudoers
# （详见 docs/NETWORK_MOUNTS.md）。Windows / macOS 下自动禁用挂载，连接配置仍可管理。
# 挂载父目录，留空 = ~/.watchdog-os/mounts；会自动并入 FS_ROOTS，无需重复写
MOUNTS_DIR=
# 启动时恢复标记为「自动挂载」的连接
MOUNTS_AUTO_MOUNT=true
# 单次 mount / umount 命令超时（毫秒）
MOUNTS_TIMEOUT_MS=30000

# == 压缩 / 解压工具（可选）==
# Files 的 zip / tar.gz 解压与压缩依赖系统归档工具，留空自动探测：
#   Windows = %SystemRoot%\System32\tar.exe（bsdtar，Win10 1803+ 自带，zip 与 tar.gz 通吃）
#   macOS   = /usr/bin/tar（bsdtar）
#   Linux   = tar + unzip（解 zip）+ zip（压 zip）；Alpine 的 busybox 亦可
# 非空 = 只用指定路径、不回落（便于固定工具版本或排查问题）
ARCHIVE_TAR_PATH=
ARCHIVE_UNZIP_PATH=
ARCHIVE_ZIP_PATH=

# == 网页终端 ttyd（可选）==
TERMINAL_ENABLED=false
TTYD_PATH=ttyd
TTYD_PORT=7681
# 要运行的 shell 及参数，JSON 数组。示例：登录 shell 才能加载 ~/.profile
TTYD_ARGS=["bash"]
# 终端启动工作目录。留空 = 用户主目录（~/）；配置后以配置为准（支持 ~ 前缀）
TTYD_CWD=
# Windows 下经 WSL 运行 Linux 版 ttyd（为 true 时忽略 TTYD_PATH）
TTYD_WSL=false

# == 脚本任务 Runner（可选）==
RUNNER_ENABLED=false
# 启用时必配：脚本绝对路径（仅服务端可设，客户端不可传）
RUNNER_SCRIPT=
RUNNER_SHELL=bash
# 任务日志超过此字节数归档为 .old
RUNNER_MAX_LOG_BYTES=5242880

# == Blog 构建（可选，复用 Runner 引擎，日志独立落 data/blog.log）==
BLOG_ENABLED=true
# 构建脚本路径（支持 ~ 前缀；仅服务端可设，客户端不可传）
BLOG_SCRIPT=
BLOG_SHELL=bash
# 任务日志超过此字节数归档为 .old
BLOG_MAX_LOG_BYTES=5242880

# == 时间源（Clock 应用）==
# 服务端向 NTP 校时后返回权威 UTC 时间戳；前端按此时间与下列时区渲染，免手动同步
# 显示时区（IANA 名称，非法值回退 Asia/Shanghai）
TIME_ZONE=Asia/Shanghai
# NTP 服务器（UDP 123，需出站可用；失败自动回退系统时间）
NTP_HOST=pool.ntp.org
# 设为 false 可完全禁用 NTP 网络请求（离线部署 / 测试），使用系统时间
NTP_ENABLED=true

# == 打印机 CUPS（可选）==
PRINTER_ENABLED=true
PRINTER_INTERVAL=10000
PRINTER_HISTORY_LIMIT=200

# == AI 聊天代理 Hermes（可选）==
HERMES_ENABLED=false
HERMES_BASE_URL=
# 上游 Bearer
HERMES_API_KEY=
# Sessions API 专用 Bearer，为空则回退 HERMES_API_KEY
HERMES_API_SERVER_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_MS=300000

# == 大模型用量 Dashboard（可选）==
USAGE_ENABLED=false
# 两个 key 留空时自动读取本机 hermes 的 .env（USAGE_ENV_FILE 可覆盖路径）；本地配置优先
# DeepSeek 余额接口 Bearer
DEEPSEEK_API_KEY=
# 留空 = 依次取 hermes 配置里的 DEEPSEEK_BASE_URL、官方默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=
# 智谱 API Key（BigModel 余额用标准 API Key 即可；国际站 ZAI_BASE_URL 改 https://api.z.ai）
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn
# hermes 配置文件路径（key 仍在 hermes 里维护，不在本项目重复填写）
USAGE_ENV_FILE=/root/.hermes/.env
USAGE_TIMEOUT_MS=15000

# == 财务账本 Ledger（可选，需 Node >=22.5 的 node:sqlite）==
# 复用 bank-ledger/ledger.db；不启用时 /api/ledger/* 除 status 外统一 503，服务其余功能不受影响
LEDGER_ENABLED=true
# 库文件路径，留空 = <项目根>/bank-ledger/ledger.db（支持 ~ 前缀与绝对路径）
LEDGER_DB=
# CSV 文本 / 请求体上限（字节）
LEDGER_MAX_IMPORT_BYTES=8388608
# SQLite busy_timeout（毫秒），与 Python 工具并发写时等待锁的时长
LEDGER_IMPORT_BUSY_TIMEOUT_MS=5000
# 备份目录，留空 = ~/.watchdog-os/ledger-backups（支持 ~ 前缀与绝对路径；不要放版本控制目录）
LEDGER_BACKUP_DIR=
# 备份保留份数，收敛到 1 ~ 200
LEDGER_BACKUP_KEEP=20
# 上传 .db 恢复文件的大小上限（字节）
LEDGER_MAX_BACKUP_BYTES=52428800
# 每次增量导入提交前自动生成一份快照（auto-before-import）
LEDGER_AUTO_BACKUP_ON_IMPORT=true
