# watchdog-os 配置模板
# 用法：复制为 .env 后按需修改   （cp .env.example .env）
# 本文件不含任何真实密钥，可安全提交；.env 本身已在 .gitignore 中。
#
# ★ 配置的唯一来源是 .env。config.json 已不再被服务读取，
#   config.example.json 只是字段总览模板（同样不参与配置）。
# ★ 未设置与空串一律视为「未设置」并回退默认值。

# == 必配（缺失则服务拒绝启动）==
# 访问密码
PASSWORD=

# JWT 令牌签名密钥，至少 32 字节。生成：openssl rand -hex 32
JWT_SECRET=

# == 服务 ==
# 监听端口 / 监听地址（0.0.0.0 表示所有网卡）
PORT=3000
HOST=0.0.0.0
# 子路径前缀，如 /tkp/（无需尾斜杠）
BASE_PATH=/

# == 监控采样 ==
# 监控哪些磁盘挂载点。JSON 数组；留空时 Windows 取项目所在盘、Linux 取 /
# ⚠️ 与 FS_ROOTS 不是一回事：DISK_MOUNTS 是采样目标，FS_ROOTS 是文件管理器权限白名单
DISK_MOUNTS=[]
COLLECT_INTERVAL=2000      # CPU / 内存采样间隔（ms）
DOCKER_INTERVAL=5000       # docker stats 刷新间隔（ms）
PROCESS_INTERVAL=10000     # 进程列表刷新间隔（ms）
PROCESS_TOP_N=50           # 进程列表返回条数（按 CPU 排序）

# == 会话安全（可选，均有合理默认值）==
# 令牌有效期（秒），自动收敛到 300 ~ 2592000
JWT_EXPIRES_IN=86400
# Cookie 的 Secure 策略：auto（默认，仅 HTTPS 请求附加）/ always / never
COOKIE_SECURE=auto
# 终端 WebSocket 的 Origin 白名单，逗号分隔；留空表示仅同源
PUBLIC_ORIGIN=

# == 文件管理器（可选）==
# 允许浏览的根目录，按系统分隔符（Windows 用 ;，Linux 用 :）
# 留空时：Windows = 项目所在盘 + C 盘根，Linux = /
# 例：FS_ROOTS=/data:/home
FS_ROOTS=

# == 网页终端 ttyd（可选）==
TERMINAL_ENABLED=false
TTYD_PATH=ttyd
TTYD_PORT=7681
# 要运行的 shell 及参数，JSON 数组。示例：登录 shell 才能加载 ~/.profile
TTYD_ARGS=["bash"]
# Windows 下经 WSL 运行 Linux 版 ttyd（为 true 时忽略 TTYD_PATH）
TTYD_WSL=false

# == 脚本任务 Runner（可选）==
RUNNER_ENABLED=false
# 启用时必配：脚本绝对路径（仅服务端可设，客户端不可传）
RUNNER_SCRIPT=
RUNNER_SHELL=bash
# 任务日志超过此字节数归档为 .old
RUNNER_MAX_LOG_BYTES=5242880

# == 打印机 CUPS（可选）==
PRINTER_ENABLED=true
PRINTER_INTERVAL=10000
PRINTER_HISTORY_LIMIT=200

# == AI 聊天代理 Hermes（可选）==
HERMES_ENABLED=false
HERMES_BASE_URL=http://192.168.100.20:8642
# 上游 Bearer
HERMES_API_KEY=
# Sessions API 专用 Bearer，为空则回退 HERMES_API_KEY
HERMES_API_SERVER_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_MS=300000