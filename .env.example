# watchdog-os 配置模板
# 用法：复制为 .env 后按需修改   （cp .env.example .env）
# 本文件不含任何真实密钥，可安全提交；.env 本身已在 .gitignore 中。
#
# ★ 配置的唯一来源是 .env。config.json 已不再被服务读取，
#   config.example.json 只是字段总览模板（同样不参与配置）。
# ★ 未设置与空串一律视为「未设置」并回退默认值。

# == 必配（缺失则服务拒绝启动）==
# 访问密码
PASSWORD=

# JWT 令牌签名密钥，至少 32 字节。生成：openssl rand -hex 32
JWT_SECRET=

# == 服务 ==
# 监听端口 / 监听地址（0.0.0.0 表示所有网卡）
PORT=
HOST=
# 子路径前缀，如 /tkp/（无需尾斜杠）
BASE_PATH=/

# == 监控采样 ==
# 监控哪些磁盘挂载点。JSON 数组；留空时 Windows 取项目所在盘、Linux 取 /
# ⚠️ 与 FS_ROOTS 不是一回事：DISK_MOUNTS 是采样目标，FS_ROOTS 是文件管理器权限白名单
DISK_MOUNTS=[]
COLLECT_INTERVAL=2000      # CPU / 内存采样间隔（ms）
DOCKER_INTERVAL=5000       # docker stats 刷新间隔（ms）
PROCESS_INTERVAL=10000     # 进程列表刷新间隔（ms）
PROCESS_TOP_N=50           # 进程列表返回条数（按 CPU 排序）

# == 会话安全（可选，均有合理默认值）==
# 令牌有效期（秒），自动收敛到 300 ~ 2592000
JWT_EXPIRES_IN=86400
# Cookie 的 Secure 策略：auto（默认，仅 HTTPS 请求附加）/ always / never
COOKIE_SECURE=auto
# 终端 WebSocket 的 Origin 白名单，逗号分隔；留空表示仅同源
PUBLIC_ORIGIN=

# == 登录审计日志（可选，默认开启）==
# 记录登录成功/失败、登出、受保护接口 401 未授权访问，按本地日期分文件落盘 JSONL
# （~/.watchdog-os/login-log/YYYY-MM-DD.jsonl）。日志不含密码、Cookie、令牌等任何凭据。
LOGIN_LOG_ENABLED=true
# 日志目录，留空 = ~/.watchdog-os/login-log（支持 ~ 前缀与绝对路径）
LOGIN_LOG_DIR=
# 保留天数（自动清理更早的日文件），收敛到 1 ~ 3650
LOGIN_LOG_RETENTION_DAYS=30
# 单次读取解析条数上限（面板 / CSV 共用），收敛到 100 ~ 200000
LOGIN_LOG_MAX_ENTRIES=20000
# 疑似暴力破解判定：同一 IP 在窗口内登录失败达到该次数，收敛到 2 ~ 100
LOGIN_LOG_BRUTE_THRESHOLD=5
# 暴力破解判定窗口（分钟），收敛到 1 ~ 1440
LOGIN_LOG_BRUTE_WINDOW_MIN=10
# 同 IP + 同路径的 401 合并窗口（秒）：防前端轮询在会话失效后刷爆日志，0 = 关闭去重
LOGIN_LOG_401_DEDUPE_SEC=60

# == 文件管理器（可选）==
# 允许浏览的根目录，按系统分隔符（Windows 用 ;，Linux 用 :）
# 留空时：Windows = 项目所在盘 + C 盘根，Linux = /
# 例：FS_ROOTS=/data:/home
FS_ROOTS=

# == 网页终端 ttyd（可选）==
TERMINAL_ENABLED=false
TTYD_PATH=ttyd
TTYD_PORT=7681
# 要运行的 shell 及参数，JSON 数组。示例：登录 shell 才能加载 ~/.profile
TTYD_ARGS=["bash"]
# Windows 下经 WSL 运行 Linux 版 ttyd（为 true 时忽略 TTYD_PATH）
TTYD_WSL=false

# == 脚本任务 Runner（可选）==
RUNNER_ENABLED=false
# 启用时必配：脚本绝对路径（仅服务端可设，客户端不可传）
RUNNER_SCRIPT=
RUNNER_SHELL=bash
# 任务日志超过此字节数归档为 .old
RUNNER_MAX_LOG_BYTES=5242880

# == Blog 构建（可选，复用 Runner 引擎，日志独立落 data/blog.log）==
BLOG_ENABLED=true
# 构建脚本路径（支持 ~ 前缀；仅服务端可设，客户端不可传）
BLOG_SCRIPT=
BLOG_SHELL=bash
# 任务日志超过此字节数归档为 .old
BLOG_MAX_LOG_BYTES=5242880

# == 打印机 CUPS（可选）==
PRINTER_ENABLED=true
PRINTER_INTERVAL=10000
PRINTER_HISTORY_LIMIT=200

# == AI 聊天代理 Hermes（可选）==
HERMES_ENABLED=false
HERMES_BASE_URL=
# 上游 Bearer
HERMES_API_KEY=
# Sessions API 专用 Bearer，为空则回退 HERMES_API_KEY
HERMES_API_SERVER_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_MS=300000

# == 大模型用量 Dashboard（可选）==
USAGE_ENABLED=false
# 两个 key 留空时自动经 SSH 读取 Mac 上 ~/.hermes/.env（USAGE_SSH_CMD 可整体覆盖读取命令）；本地配置优先
# DeepSeek 余额接口 Bearer
DEEPSEEK_API_KEY=
# 留空 = 依次取 hermes 配置里的 DEEPSEEK_BASE_URL、官方默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=
# 智谱 Coding 套餐 Key（与标准 API Key 不通用；国际站 ZAI_BASE_URL 改 https://api.z.ai）
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn
# 注意远端引号：本地双引号包住整条远端命令，单引号留给远端 shell（否则 zsh 会把 ^ 视为扩展 glob）
USAGE_SSH_CMD=ssh -o BatchMode=yes -o ConnectTimeout=5 mac "grep -E '^(DEEPSEEK_API_KEY|DEEPSEEK_BASE_URL|GLM_API_KEY|ZAI_API_KEY)=' ~/.hermes/.env"
USAGE_TIMEOUT_MS=15000
